<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <include
            layout="@layout/brand_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connect_title"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connect_intro"
            android:textAppearance="?attr/textAppearanceBody1"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/orgUrlLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/connect_org_url_label"
            app:placeholderText="@string/connect_org_url_hint"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <!-- The example URL is the TextInputLayout's placeholderText (shown only
                 while empty + focused, under the floated label). Do NOT also set
                 android:hint here: with the OutlinedBox label that renders both the
                 label and the placeholder on top of each other and clobbers the field. -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/orgUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:autofillHints="url" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/connect_button" />

        <TextView
            android:id="@+id/signupHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/connect_signup_hint"
            android:textAppearance="?attr/textAppearanceCaption" />

        <TextView
            android:id="@+id/statusMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
