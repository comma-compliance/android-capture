<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <include
            layout="@layout/brand_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_title"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/connectionState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/connectedTo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBody1"
            android:layout_marginBottom="24dp" />

        <!-- Leading label column: paddingEnd is the gap before the value column and
             is intentionally one-sided (a leading padding would push the labels off
             the start edge). The direction-aware paddingEnd already flips correctly
             under RTL, so symmetric padding is not wanted here. -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1"
            android:layout_marginBottom="24dp"
            tools:ignore="RtlSymmetry">

            <TableRow>
                <TextView android:text="@string/status_device_id" android:paddingEnd="12dp" android:textAppearance="?attr/textAppearanceBody2" />
                <TextView android:id="@+id/deviceId" android:textAppearance="?attr/textAppearanceBody2" />
            </TableRow>
            <TableRow>
                <TextView android:text="@string/status_last_sync" android:paddingEnd="12dp" android:textAppearance="?attr/textAppearanceBody2" />
                <TextView android:id="@+id/lastSync" android:textAppearance="?attr/textAppearanceBody2" />
            </TableRow>
            <TableRow>
                <TextView android:text="@string/status_pending" android:paddingEnd="12dp" android:textAppearance="?attr/textAppearanceBody2" />
                <TextView android:id="@+id/pendingCount" android:textAppearance="?attr/textAppearanceBody2" />
            </TableRow>
            <TableRow>
                <TextView android:text="@string/status_connectivity" android:paddingEnd="12dp" android:textAppearance="?attr/textAppearanceBody2" />
                <TextView android:id="@+id/connectivity" android:textAppearance="?attr/textAppearanceBody2" />
            </TableRow>
            <TableRow>
                <TextView android:text="@string/status_auth" android:paddingEnd="12dp" android:textAppearance="?attr/textAppearanceBody2" />
                <TextView android:id="@+id/authState" android:textAppearance="?attr/textAppearanceBody2" />
            </TableRow>
            <TableRow>
                <TextView android:text="@string/status_last_check" android:paddingEnd="12dp" android:textAppearance="?attr/textAppearanceBody2" />
                <TextView android:id="@+id/lastCheck" android:textAppearance="?attr/textAppearanceBody2" />
            </TableRow>
            <TableRow>
                <TextView android:text="@string/status_app_version" android:paddingEnd="12dp" android:textAppearance="?attr/textAppearanceBody2" />
                <TextView android:id="@+id/appVersion" android:textAppearance="?attr/textAppearanceBody2" />
            </TableRow>
        </TableLayout>

        <TextView
            android:id="@+id/storageWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_storage_warning"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?attr/colorError"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/queueWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_queue_unavailable"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?attr/colorError"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rationale_privacy_summary"
            android:textAppearance="?attr/textAppearanceCaption"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selfTestButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_self_test"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <TextView
            android:id="@+id/selfTestResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/disconnectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/status_disconnect"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </LinearLayout>
</ScrollView>
